---
/**
 * Optional Google rating badge component
 * Must be explicitly enabled via showRating prop
 * Requires disclaimer text when enabled
 * Do NOT use real review numbers - for display/demo only
 */

interface Props {
  showRating?: boolean;
  disclaimer?: string;
}

const { 
  showRating = false,
  disclaimer = 'Ratings are for illustrative purposes. Results vary and past client experiences do not guarantee future outcomes.'
} = Astro.props;
---

{showRating && (
  <div class="rating-badge">
    <div class="rating-badge__content">
      <div class="rating-badge__google">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <span class="rating-badge__text">Google</span>
      </div>
      <div class="rating-badge__stars">
        <span class="rating-badge__score">4.9</span>
        <div class="rating-badge__star-group" aria-label="4.9 out of 5 stars">
          {[1, 2, 3, 4, 5].map(() => (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#FDB022" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          ))}
        </div>
      </div>
    </div>
    {disclaimer && (
      <p class="rating-badge__disclaimer">{disclaimer}</p>
    )}
  </div>
)}

<style>
  .rating-badge {
    margin-top: var(--space-24);
  }
  
  .rating-badge__content {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-16);
    background-color: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-default);
    width: fit-content;
  }
  
  .rating-badge__google {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-right: var(--space-16);
    border-right: 1px solid var(--color-line);
  }
  
  .rating-badge__text {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-ink);
  }
  
  .rating-badge__stars {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  
  .rating-badge__score {
    font-size: var(--text-h5);
    font-weight: 600;
    color: var(--color-ink);
  }
  
  .rating-badge__star-group {
    display: flex;
    gap: 2px;
  }
  
  .rating-badge__disclaimer {
    margin-top: var(--space-8);
    font-size: var(--text-caption);
    color: var(--color-muted);
    font-style: italic;
    max-width: 400px;
  }
  
  @media (max-width: 767px) {
    .rating-badge__content {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .rating-badge__google {
      padding-right: 0;
      padding-bottom: var(--space-8);
      border-right: none;
      border-bottom: 1px solid var(--color-line);
      width: 100%;
    }
  }
</style>
