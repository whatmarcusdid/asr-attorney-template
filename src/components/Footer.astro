---
interface Props {
  responsibleAttorney: string;
  firmName?: string;
  address?: string;
  phone?: string;
  email?: string;
}

const { 
  responsibleAttorney,
  firmName = 'Law Firm Name',
  address = '123 Main Street, City, State 12345',
  phone = '(555) 123-4567',
  email = 'info@lawfirm.com'
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__grid">
      <div class="footer__brand">
        <h3 class="footer__firm-name">{firmName}</h3>
        <p class="footer__address">{address}</p>
      </div>
      
      <div class="footer__contact">
        <h4 class="footer__heading">Contact</h4>
        <ul class="footer__list">
          <li><a href={`tel:${phone.replace(/\D/g, '')}`} class="footer__link">{phone}</a></li>
          <li><a href={`mailto:${email}`} class="footer__link">{email}</a></li>
        </ul>
      </div>
      
      <div class="footer__legal">
        <h4 class="footer__heading">Quick Links</h4>
        <ul class="footer__list">
          <li><a href="/privacy-policy" class="footer__link">Privacy Policy</a></li>
          <li><a href="/terms" class="footer__link">Terms of Use</a></li>
          <li><a href="/sitemap" class="footer__link">Sitemap</a></li>
        </ul>
      </div>
    </div>
    
    <div class="footer__bottom">
      <p class="footer__responsible">
        <strong>Responsible Attorney:</strong> {responsibleAttorney}
      </p>
      <p class="footer__disclaimer">
        This website is for informational purposes only and does not constitute legal advice. 
        An attorney-client relationship is not formed by using this website. 
        Results may vary and past results do not guarantee future outcomes.
      </p>
      <p class="footer__copyright">
        &copy; {currentYear} {firmName}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-accent-navy);
    color: var(--color-white);
    padding: var(--space-64) var(--space-32) var(--space-32);
  }
  
  .footer__container {
    max-width: 1440px;
    margin: 0 auto;
  }
  
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), 1fr);
    gap: var(--grid-gap);
    margin-bottom: var(--space-48);
  }
  
  .footer__brand {
    grid-column: span 4;
  }
  
  .footer__contact,
  .footer__legal {
    grid-column: span 4;
  }
  
  .footer__firm-name {
    font-size: var(--text-h5);
    margin-bottom: var(--space-16);
    color: var(--color-white);
  }
  
  .footer__address {
    color: var(--color-mist);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
  }
  
  .footer__heading {
    font-size: var(--text-h6);
    margin-bottom: var(--space-16);
    color: var(--color-white);
  }
  
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer__list li {
    margin-bottom: var(--space-8);
  }
  
  .footer__link {
    color: var(--color-mist);
    text-decoration: none;
    font-size: var(--text-body-sm);
    transition: color var(--transition-base);
  }
  
  .footer__link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }
  
  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: var(--space-32);
  }
  
  .footer__responsible {
    font-size: var(--text-body-sm);
    color: var(--color-white);
    margin-bottom: var(--space-16);
  }
  
  .footer__responsible strong {
    font-weight: 600;
  }
  
  .footer__disclaimer {
    font-size: var(--text-caption);
    color: var(--color-mist);
    line-height: var(--leading-body);
    margin-bottom: var(--space-16);
    max-width: 800px;
  }
  
  .footer__copyright {
    font-size: var(--text-caption);
    color: var(--color-mist);
  }
  
  @media (max-width: 1024px) {
    .footer__brand,
    .footer__contact,
    .footer__legal {
      grid-column: span 4;
    }
  }
  
  @media (max-width: 767px) {
    .footer {
      padding: var(--space-48) var(--space-16) var(--space-24);
    }
    
    .footer__brand,
    .footer__contact,
    .footer__legal {
      grid-column: span 4;
    }
    
    .footer__grid {
      margin-bottom: var(--space-32);
    }
  }
</style>
