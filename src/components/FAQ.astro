---
interface Props {
  question: string;
  id?: string;
}

const { question, id } = Astro.props;
const buttonId = id ? `faq-${id}` : undefined;
const contentId = id ? `faq-content-${id}` : undefined;
---

<div class="faq">
  <button
    class="faq__button"
    aria-expanded="false"
    aria-controls={contentId}
    id={buttonId}
    data-faq-toggle
  >
    <span class="faq__question">{question}</span>
    <svg 
      class="faq__icon" 
      width="24" 
      height="24" 
      viewBox="0 0 256 256" 
      fill="currentColor"
      aria-hidden="true"
    >
      <path class="faq__icon-plus" d="M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z"/>
      <path class="faq__icon-x" d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/>
    </svg>
  </button>
  <div 
    class="faq__content" 
    id={contentId}
    aria-labelledby={buttonId}
    data-faq-content
    hidden
  >
    <div class="faq__answer">
      <slot />
    </div>
  </div>
</div>

<script>
  function initFAQs() {
    const faqs = document.querySelectorAll('[data-faq-toggle]');
    
    faqs.forEach(button => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        const content = button.nextElementSibling as HTMLElement;
        
        if (!content) return;
        
        button.setAttribute('aria-expanded', String(!isExpanded));
        
        if (isExpanded) {
          content.hidden = true;
        } else {
          content.hidden = false;
        }
      });
    });
  }
  
  // Initialize on load
  initFAQs();
  
  // Re-initialize on view transitions (if using Astro view transitions)
  document.addEventListener('astro:page-load', initFAQs);
</script>

<style>
  .faq {
    border-bottom: 1px solid var(--color-line);
  }
  
  .faq__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: var(--space-16);
    padding: var(--space-24) 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: color var(--transition-base);
  }
  
  .faq__button:hover {
    color: var(--color-button-primary);
  }
  
  .faq__question {
    flex: 1;
    font-family: var(--font-heading);
    font-size: var(--text-h5);
    line-height: var(--leading-heading);
    color: var(--color-ink);
    transition: color var(--transition-base);
  }
  
  .faq__button:hover .faq__question {
    color: var(--color-button-primary);
  }
  
  .faq__icon {
    flex-shrink: 0;
    color: var(--color-secondary-copper);
    position: relative;
    transition: transform var(--transition-base);
  }
  
  .faq__icon-plus {
    opacity: 1;
    transition: opacity var(--transition-base);
  }
  
  .faq__icon-x {
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity var(--transition-base);
  }
  
  .faq__button[aria-expanded="true"] .faq__icon-plus {
    opacity: 0;
  }
  
  .faq__button[aria-expanded="true"] .faq__icon-x {
    opacity: 1;
  }
  
  .faq__content {
    overflow: hidden;
  }
  
  .faq__answer {
    padding-bottom: var(--space-24);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--color-muted);
  }
  
  .faq__answer :global(p:last-child) {
    margin-bottom: 0;
  }
  
  @media (max-width: 767px) {
    .faq__question {
      font-size: var(--text-h6);
    }
  }
</style>
