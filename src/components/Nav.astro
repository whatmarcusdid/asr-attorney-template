---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links?: NavLink[];
  logo?: string;
  logoAlt?: string;
}

const { 
  links = [
    { label: 'Practice Areas', href: '/practice-areas' },
    { label: 'Resources', href: '/resources' },
    { label: 'Contact', href: '/contact' }
  ],
  logo = '/logo.svg',
  logoAlt = 'Law Firm'
} = Astro.props;
---

<nav class="nav" aria-label="Primary navigation">
  <div class="nav__container">
    <a href="/" class="nav__logo">
      <img src={logo} alt={logoAlt} width="180" height="60" />
    </a>
    
    <button 
      class="nav__toggle" 
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="nav__toggle-icon"></span>
    </button>
    
    <div class="nav__menu" data-nav-menu>
      <ul class="nav__list">
        {links.map(link => (
          <li class="nav__item">
            <a href={link.href} class="nav__link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<script>
  const toggle = document.querySelector('[data-nav-toggle]') as HTMLButtonElement;
  const menu = document.querySelector('[data-nav-menu]') as HTMLElement;
  
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('nav__menu--open');
      document.body.style.overflow = isExpanded ? '' : 'hidden';
    });
    
    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('nav__menu--open')) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('nav__menu--open');
        document.body.style.overflow = '';
        toggle.focus();
      }
    });
    
    // Close menu when clicking links
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('nav__menu--open');
        document.body.style.overflow = '';
      });
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-line);
  }
  
  .nav__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-32);
  }
  
  .nav__logo {
    flex-shrink: 0;
    z-index: 2;
  }
  
  .nav__logo img {
    display: block;
    height: auto;
  }
  
  .nav__toggle {
    display: none;
    width: var(--tap-target-min);
    height: var(--tap-target-min);
    background: none;
    border: none;
    padding: 0;
    z-index: 2;
  }
  
  .nav__toggle-icon {
    display: block;
    position: relative;
    width: 24px;
    height: 2px;
    background-color: var(--color-ink);
    margin: 0 auto;
    transition: background-color var(--transition-base);
  }
  
  .nav__toggle-icon::before,
  .nav__toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-ink);
    transition: transform var(--transition-base);
  }
  
  .nav__toggle-icon::before {
    top: -8px;
  }
  
  .nav__toggle-icon::after {
    bottom: -8px;
  }
  
  .nav__toggle[aria-expanded="true"] .nav__toggle-icon {
    background-color: transparent;
  }
  
  .nav__toggle[aria-expanded="true"] .nav__toggle-icon::before {
    transform: translateY(8px) rotate(45deg);
  }
  
  .nav__toggle[aria-expanded="true"] .nav__toggle-icon::after {
    transform: translateY(-8px) rotate(-45deg);
  }
  
  .nav__menu {
    display: flex;
  }
  
  .nav__list {
    display: flex;
    gap: var(--space-32);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .nav__link {
    display: block;
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    padding: var(--space-8) 0;
    transition: color var(--transition-base);
  }
  
  .nav__link:hover {
    color: var(--color-button-primary);
    text-decoration: none;
  }
  
  /* Mobile styles */
  @media (max-width: 1024px) {
    .nav__toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .nav__menu {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background-color: var(--color-white);
      padding: calc(var(--space-64) + var(--tap-target-min)) var(--space-32) var(--space-32);
      transform: translateX(100%);
      transition: transform var(--transition-base);
    }
    
    .nav__menu--open {
      transform: translateX(0);
    }
    
    .nav__list {
      flex-direction: column;
      gap: var(--space-24);
    }
    
    .nav__link {
      font-size: var(--text-h5);
    }
  }
</style>
