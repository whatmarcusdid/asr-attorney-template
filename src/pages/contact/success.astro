---
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import Heading from '@components/Heading.astro';
---

<BaseLayout 
  title="Message Sent | Thank You"
  description="Your message has been received. We'll be in touch soon."
>
  <Nav />
  
  <main>
    <Section spacing="large">
      <div class="success-message">
        <div class="success-icon">
          <svg width="64" height="64" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path>
          </svg>
        </div>
        
        <Heading level={1} accent="received">Message</Heading>
        
        <p class="success-description">
          Thank you for contacting us. We've received your message and will respond within one business day.
        </p>
        
        <div class="success-actions">
          <Button href="/" variant="filled" theme="on-light">
            Return Home
          </Button>
          <Button href="/resources" variant="outline" theme="on-light">
            Browse Resources
          </Button>
        </div>
        
        <p class="success-note">
          Please note: Submitting this form does not create an attorney-client relationship. Do not rely on this message as legal advice.
        </p>
      </div>
    </Section>
  </main>
  
  <Footer 
    responsibleAttorney="Attorney Name, Esq."
    firmName="Law Firm Name"
  />
</BaseLayout>

<style>
  .success-message {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    margin-bottom: var(--space-32);
    color: var(--color-secondary-copper);
    background-color: var(--color-mist);
    border-radius: 50%;
  }
  
  .success-description {
    font-size: var(--text-body-lg);
    color: var(--color-muted);
    line-height: var(--leading-body);
    margin: var(--space-24) 0 var(--space-48);
  }
  
  .success-actions {
    display: flex;
    gap: var(--space-16);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-48);
  }
  
  .success-note {
    font-size: var(--text-body-sm);
    color: var(--color-muted);
    line-height: var(--leading-body);
    padding: var(--space-16);
    background-color: var(--color-mist);
    border-radius: var(--radius-default);
  }
  
  @media (max-width: 767px) {
    .success-actions {
      flex-direction: column;
      width: 100%;
    }
    
    .success-actions :global(a),
    .success-actions :global(button) {
      width: 100%;
    }
  }
</style>
